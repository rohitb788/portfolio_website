# Copy this file to .env.local for local development.
# In production (Vercel), set these as Environment Variables in the project settings instead.
# None of these are ever read on the client — only inside server-side API routes.

# The single admin password. Choose something long and random; this is the only credential
# gating the editing UI at /admin.
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie (HMAC). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# GitHub personal access token used server-side to commit content edits.
# Needs write access to the single repo below only:
#   - Fine-grained token: Contents = Read and write, scoped to this repo.
#   - Classic token: "repo" scope (broader; fine-grained is recommended).
GITHUB_TOKEN=

# The repo edits get committed to, e.g. GITHUB_REPO_OWNER=your-username, GITHUB_REPO_NAME=portfolio-website
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Branch to commit to. Defaults to "main" if unset.
GITHUB_REPO_BRANCH=main
